# PREMAL KAIZEN Environment Variables

# Application
NODE_ENV=development
APP_NAME=PREMAL KAIZEN
APP_URL=http://localhost:3000

# Storefront
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3002

# Admin Panel
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3002

# Backend API
API_PORT=3002
API_HOST=0.0.0.0
DATABASE_URL=postgresql://user:password@localhost:5432/premal_kaizen
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=premal_kaizen
DB_USER=postgres
DB_PASSWORD=password

# Optional: Payment Gateway (if using Stripe)
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional: Email Service
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
