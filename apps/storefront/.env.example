# =============================================================================
# PREMAL KAIZEN STOREFRONT — Environment Variables Reference
# Copy this file to .env.local (Next.js dev) and fill in real values, or pass
# these as --build-arg values when building the production Docker image (see
# apps/storefront/Dockerfile) - they get baked into the client JS bundle at
# build time, so there is no sane runtime-only default for a production image.
# NEVER commit .env or .env.local to version control.
# =============================================================================

# Base URL of the API this storefront talks to.
NEXT_PUBLIC_API_URL=http://localhost:3002

# Canonical production domain - used for metadataBase, sitemap.ts, robots.ts
# and OpenGraph/Twitter card URLs (see lib/metadata.ts). Falls back to
# http://localhost:3000 when unset, which is correct for local dev only -
# MUST be set to the real production domain before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
