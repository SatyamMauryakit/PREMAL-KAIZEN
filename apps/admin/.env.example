# =============================================================================
# PREMAL KAIZEN ADMIN — Environment Variables Reference
# Copy this file to .env.local (Next.js dev) and fill in real values, or pass
# these as --build-arg values when building the production Docker image (see
# apps/admin/Dockerfile) - they get baked into the client JS bundle at build
# time, so there is no sane runtime-only default for a production image.
# NEVER commit .env or .env.local to version control.
# =============================================================================

# Base URL of the API this admin panel talks to.
NEXT_PUBLIC_API_URL=http://localhost:3002

# Base URL of the customer-facing storefront (used for "View on storefront"-style
# links from the admin panel, e.g. previewing a product/banner as a customer would see it).
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
