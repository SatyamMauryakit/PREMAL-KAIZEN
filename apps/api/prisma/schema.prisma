// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTHENTICATION & CUSTOMERS
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String    // Hashed password (bcrypt)

  // Role-based access: 'customer' or 'admin'
  role          String    @default("customer")

  // Customer profile
  firstName     String?
  lastName      String?
  phoneNumber   String?

  // Account status
  isActive      Boolean   @default(true)
  lastLogin     DateTime?

  // Relations
  addresses     Address[]
  orders        Order[]
  wishlist      WishlistItem[]
  sessions      Session[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([emailVerified])
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  token         String    @unique
  expiresAt     DateTime

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  type      String    // 'email_verification' or 'password_reset'
  expiresAt DateTime

  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Address {
  id          String    @id @default(cuid())
  userId      String

  // Address details
  label       String    // 'Home', 'Office', etc.
  firstName   String
  lastName    String
  phoneNumber String
  street1     String    // Street address
  street2     String?   // Apartment, suite, etc.
  city        String
  state       String    // State or province
  postalCode  String
  country     String

  // Default address for delivery
  isDefault   Boolean   @default(false)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([isDefault])
}

// ============================================================================
// PRODUCTS & CATALOG (reusable across all services)
// ============================================================================

model Product {
  id          String    @id @default(cuid())
  name        String
  description String
  sku         String    @unique

  // Pricing
  price       Int       // in paise (1 INR = 100 paise)
  originalPrice Int?

  // Media
  images      ProductImage[]

  // Categorization
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  // Availability
  isActive    Boolean   @default(true)

  // Variants (stored as JSON-encoded strings - SQLite has no native array/json type)
  colors      String    @default("[]")
  sizes       String    @default("[]")

  // Wishlist items
  wishlistItems WishlistItem[]

  // Cart items
  cartItems   CartItem[]

  // Order items
  orderItems  OrderItem[]

  // Inventory (Phase 12)
  inventory   Inventory[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([sku])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  url       String
  alt       String?
  order     Int       @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ============================================================================
// CART & WISHLIST
// ============================================================================

model CartItem {
  id          String    @id @default(cuid())
  userId      String?   // Null for guest cart (session-based)
  productId   String
  quantity    Int       @default(1)
  selectedSize String?
  selectedColor String?

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([productId])
}

model WishlistItem {
  id        String    @id @default(cuid())
  userId    String
  productId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ============================================================================
// ORDERS
// ============================================================================

model Order {
  id            String    @id @default(cuid())
  userId        String
  orderNumber   String    @unique  // e.g., PK-2024-001 (Phase 11 addition)

  // Fulfillment status
  status        String    @default("pending") // pending, confirmed, processing, packed, shipped, out_for_delivery, delivered, cancelled

  // Payment
  paymentMethod String    @default("cod") // card, upi, netbanking, cod
  paymentStatus String    @default("pending") // pending, completed, failed, refunded

  // Pricing
  subtotal      Int       // in paise (before discount)
  discount      Int       @default(0) // discount amount in paise (Phase 13)
  shipping      Int       @default(0)
  tax           Int       @default(0)
  total         Int       // final amount in paise

  // Promotions (Phase 13)
  promotionId   String?   // Applied promotion ID
  couponCode    String?   // Applied coupon code

  // Shipping
  shippingMethod String   @default("standard") // standard, express, overnight
  carrier       String?   // e.g., "FedEx", "DHL" (Phase 11 addition)
  addressId     String?
  trackingNumber String?
  estimatedDelivery DateTime?

  // Admin notes (Phase 11 addition)
  notes         String?
  internalNotes String?   // For admin-only notes

  // Order items
  items         OrderItem[]

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotion     Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([promotionId])
  @@index([createdAt])
  @@index([orderNumber])
}

model OrderItem {
  id        String    @id @default(cuid())
  orderId   String
  productId String

  quantity  Int
  price     Int       // Price at time of order (in paise)
  selectedSize String?
  selectedColor String?

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

// ============================================================================
// INVENTORY (Phase 12)
// ============================================================================

model Inventory {
  id                String    @id @default(cuid())
  productId         String

  // Variant details (size/color combination)
  size              String?   // null for products without sizes
  color             String?   // null for products without colors

  // Stock levels (all in units)
  onHand            Int       @default(0)    // Physically recorded stock
  reserved          Int       @default(0)    // Stock allocated to active orders
  reorderThreshold  Int       @default(10)   // Low-stock threshold

  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Audit trail
  adjustments       InventoryAdjustment[]
  auditLogs         InventoryAuditLog[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([productId, size, color]) // One inventory record per variant
  @@index([productId])
  @@index([onHand])
}

model InventoryAdjustment {
  id                String    @id @default(cuid())
  inventoryId       String

  // Adjustment details
  type              String    // 'received', 'correction', 'damage', 'manual_reconciliation', 'reserved', 'released'
  quantity          Int       // Can be positive or negative
  reason            String    // Required reason for audit trail
  reference         String?   // Optional reference (PO number, order ID, etc.)

  // Change tracking
  previousOnHand    Int       // Stock level before adjustment
  newOnHand         Int       // Stock level after adjustment

  // Admin info
  adminId           String?   // Admin who made the adjustment
  notes             String?

  inventory         Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([inventoryId])
  @@index([type])
  @@index([createdAt])
}

model InventoryAuditLog {
  id                String    @id @default(cuid())
  inventoryId       String
  adjustmentId      String?   // Reference to adjustment if from adjustment

  // State change
  previousOnHand    Int
  newOnHand         Int
  previousReserved  Int
  newReserved       Int

  // What changed
  changeType        String    // 'adjustment', 'reservation', 'release', 'order_placed', 'order_cancelled'
  reason            String?
  reference         String?   // e.g., order ID, adjustment ID

  // Who changed it
  userId            String?   // For customer actions
  adminId           String?   // For admin actions

  inventory         Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([inventoryId])
  @@index([changeType])
  @@index([createdAt])
}

// ============================================================================
// PROMOTIONS & COUPONS (Phase 13)
// ============================================================================

model Promotion {
  id                    String    @id @default(cuid())
  name                  String    @unique
  description           String?

  // Promotion type and discount
  type                  String    // 'percentage', 'fixed_amount', 'free_shipping'
  value                 Int?      // For percentage: 0-100, For fixed: amount in paise
  maxDiscount           Int?      // Maximum discount cap in paise (for percentage promos)

  // Eligibility rules
  minSubtotal           Int?      // Minimum order subtotal in paise
  firstOrderOnly        Boolean   @default(false)

  // Products & categories (stored as JSON-encoded strings - SQLite has no native array/json type)
  eligibleProductIds    String    @default("[]") // Empty = all products eligible
  eligibleCategoryIds   String    @default("[]") // Empty = all categories eligible
  excludedProductIds    String    @default("[]")
  excludedCategoryIds   String    @default("[]")

  // Schedule
  startDate             DateTime?
  expiryDate            DateTime?
  isActive              Boolean   @default(false)

  // Usage limits
  totalUsageLimit       Int?      // Total times this promotion can be used
  usageCount            Int       @default(0)
  perCustomerLimit      Int?      // Max times per customer

  // Metadata
  code                  String?   // For manual coupon-based promotions
  isArchived            Boolean   @default(false)

  // Relations
  orders                Order[]
  coupons               CouponCode[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([expiryDate])
}

model CouponCode {
  id                String    @id @default(cuid())
  code              String    @unique // Case-insensitive in application
  promotionId       String

  // Specific coupon limits (can override promotion limits)
  usageLimit        Int?      // Total uses for this code
  usageCount        Int       @default(0)
  perCustomerLimit  Int?      // Per-customer limit for this code

  // Status
  isActive          Boolean   @default(true)
  expiryDate        DateTime?

  // Metadata
  generatedAt       DateTime  @default(now())
  description       String?

  // Relations
  promotion         Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  redemptions       CouponRedemption[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([code])
  @@index([promotionId])
  @@index([isActive])
}

model CouponRedemption {
  id              String    @id @default(cuid())
  couponCodeId    String
  userId          String
  orderId         String?   // NULL if redemption cancelled/failed

  // Redemption status
  status          String    @default("completed") // 'completed', 'cancelled', 'refunded'
  discountAmount  Int       // Amount redeemed in paise

  // Relations
  couponCode      CouponCode @relation(fields: [couponCodeId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([couponCodeId])
  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// STORE SETTINGS (Phase 16)
// ============================================================================

model StoreSettings {
  id                String    @id @default("singleton") // Always use 'singleton' to enforce single record

  // Store Information
  storeName         String    @default("PREMAL KAIZEN")
  storeEmail        String    @default("support@premalkaizen.com")
  storePhone        String    @default("+91-XXX-XXX-XXXX")
  businessAddress   String    @default("")

  // Regional Settings
  timezone          String    @default("Asia/Kolkata")
  locale            String    @default("en-IN")
  currency          String    @default("INR")

  // Shipping Configuration (JSON stored as text for flexibility)
  shippingMethods   String    @default("[]") // JSON array of shipping methods

  // Tax Configuration
  defaultTaxRate    Float     @default(0)   // Default tax rate as percentage
  taxCalculationMode String   @default("exclusive") // 'inclusive' or 'exclusive'

  // Checkout Policies
  guestCheckoutEnabled Boolean @default(true)
  minimumOrderValue  Int      @default(0)   // Minimum order value in paise
  maintenanceMode   Boolean  @default(false)
  maintenanceMessage String   @default("")

  // Notification Preferences
  orderConfirmationEnabled Boolean @default(true)
  paymentNotificationsEnabled Boolean @default(true)
  shippingNotificationsEnabled Boolean @default(true)
  lowStockNotificationsEnabled Boolean @default(true)

  // Security & Integrations
  stripeEnabled     Boolean  @default(false)
  razorpayEnabled   Boolean  @default(false)
  emailNotificationsEnabled Boolean @default(true)
  smsNotificationsEnabled Boolean @default(false)

  // Audit
  lastModifiedAt    DateTime  @default(now()) @updatedAt
  lastModifiedBy    String?   // Admin user ID who made the last change

  @@unique([id]) // Enforce singleton pattern
}

model SettingsAuditLog {
  id                String    @id @default(cuid())
  setting           String    // Name of the setting that was changed
  previousValue     String?   // Previous value (JSON string)
  newValue          String?   // New value (JSON string)
  changedBy         String    // Admin user ID
  changeReason      String?   // Reason for the change

  createdAt         DateTime  @default(now())

  @@index([setting])
  @@index([changedBy])
  @@index([createdAt])
}
