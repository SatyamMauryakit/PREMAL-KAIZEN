# =============================================================================
# PREMAL KAIZEN API — Environment Variables Reference
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (local dev)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production) — uncomment and fill in when deploying
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
API_PORT=3002
API_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Razorpay payment gateway
# https://dashboard.razorpay.com → Settings → API Keys
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX        # publishable — safe in client bundles
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXX  # KEEP SECRET — server only
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXX # From Settings → Webhooks

# ---------------------------------------------------------------------------
# SMTP (transactional email)
# Used for: order confirmation, OTP verification, password reset,
#           payment notifications, shipping updates.
# Examples: Gmail (with App Password), Mailtrap, SendGrid SMTP relay.
# Leave ALL FOUR blank to disable email — emails skip gracefully (no error).
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com          # e.g. smtp.gmail.com / smtp.sendgrid.net
SMTP_PORT=587                     # 587 (STARTTLS) or 465 (SSL)
SMTP_USER=you@yourdomain.com      # SMTP login username
SMTP_PASSWORD=your-app-password   # KEEP SECRET — never commit

# From address shown to recipients
EMAIL_FROM="PREMAL KAIZEN <premal.kaizen@gmail.com>"

# ---------------------------------------------------------------------------
# Storefront URL (used in email links and invoice PDF)
# Set to your real domain in production.
# ---------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Contact form notifications (optional)
# If set, every contact-form submission also emails this address.
# ---------------------------------------------------------------------------
CONTACT_NOTIFICATION_EMAIL=owner@yourdomain.com

# ---------------------------------------------------------------------------
# Instagram URL (optional)
# If set, shown in email footer. Falls back to the hardcoded storefront value.
# ---------------------------------------------------------------------------
INSTAGRAM_URL=https://www.instagram.com/premal.kaizen

# ---------------------------------------------------------------------------
# Notification outbox poller (optional — defaults shown)
# ---------------------------------------------------------------------------
NOTIF_POLL_INTERVAL_MS=10000   # How often (ms) to drain the NotificationEvent queue
NOTIF_MAX_ATTEMPTS=5           # Max send retries before giving up
NOTIF_BASE_BACKOFF_MS=15000    # Base backoff (doubles per retry, capped at 30 min)

# ---------------------------------------------------------------------------
# Mobile OTP — NOT YET IMPLEMENTED
# An SMS provider must be integrated before mobile OTP can be sent.
# Options: Twilio, MSG91, TextLocal, AWS SNS.
# Required env vars will vary by provider — document them here once chosen.
# ---------------------------------------------------------------------------
# SMS_PROVIDER=twilio
# SMS_API_KEY=XXXX
# SMS_FROM=+91XXXXXXXXXX
