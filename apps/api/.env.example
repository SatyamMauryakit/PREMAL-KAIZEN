# =============================================================================
# PREMAL KAIZEN API — Environment Variables Reference
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database
#
# Local dev uses SQLite against apps/api/prisma/schema.prisma. Production uses
# PostgreSQL against the separate apps/api/prisma-postgres/schema.prisma (kept
# in sync with the SQLite schema by hand - see that file's own header comment).
# ---------------------------------------------------------------------------
# SQLite (local dev - default)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production/staging - uncomment and fill in when deploying; matches
# deploy-compose/docker-compose.yml's POSTGRES_USER/PASSWORD/DB)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# POSTGRES_USER=premal
# POSTGRES_PASSWORD=
# POSTGRES_DB=premal_kaizen

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
API_PORT=3002
API_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# CORS - comma-separated exact origins allowed to call this API from a browser.
# No wildcard support by design (see src/common/config/cors.ts) - falls back to
# http://localhost:3000,http://localhost:3001 (storefront, admin) when unset,
# which is correct for local dev but must be set explicitly for any real deploy.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------------------------------------------------------------------------
# File storage - product images and other uploads.
# STORAGE_DRIVER=local (default) writes to apps/api/uploads/ on local disk - fine
# for dev, but doesn't survive a container restart/replacement in production.
# STORAGE_DRIVER=s3 writes to the S3 bucket below instead; the EC2 instance role
# (or local AWS credentials in dev) must have read/write access to it - never
# put an AWS access key/secret here, use an IAM role in production.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# AWS_REGION=ap-south-1
# S3_BUCKET=

# ---------------------------------------------------------------------------
# Razorpay payment gateway
# https://dashboard.razorpay.com → Settings → API Keys
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX        # publishable — safe in client bundles
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXX  # KEEP SECRET — server only
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXX # From Settings → Webhooks

# ---------------------------------------------------------------------------
# SMTP (transactional email)
# Used for: order confirmation, OTP verification, password reset,
#           payment notifications, shipping updates.
# Examples: Gmail (with App Password), Mailtrap, SendGrid SMTP relay.
# Leave ALL FOUR blank to disable email — emails skip gracefully (no error).
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com          # e.g. smtp.gmail.com / smtp.sendgrid.net
SMTP_PORT=587                     # 587 (STARTTLS) or 465 (SSL)
SMTP_USER=you@yourdomain.com      # SMTP login username
SMTP_PASSWORD=your-app-password   # KEEP SECRET — never commit

# From address shown to recipients
EMAIL_FROM="PREMAL KAIZEN <premal.kaizen@gmail.com>"

# ---------------------------------------------------------------------------
# Storefront URL (used in email links and invoice PDF)
# Set to your real domain in production.
# ---------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Contact form notifications (optional)
# If set, every contact-form submission also emails this address.
# ---------------------------------------------------------------------------
CONTACT_NOTIFICATION_EMAIL=owner@yourdomain.com

# ---------------------------------------------------------------------------
# Instagram URL (optional)
# If set, shown in email footer. Falls back to the hardcoded storefront value.
# ---------------------------------------------------------------------------
INSTAGRAM_URL=https://www.instagram.com/premal.kaizen

# ---------------------------------------------------------------------------
# Notification outbox poller (optional — defaults shown)
# ---------------------------------------------------------------------------
NOTIF_POLL_INTERVAL_MS=10000   # How often (ms) to drain the NotificationEvent queue
NOTIF_MAX_ATTEMPTS=5           # Max send retries before giving up
NOTIF_BASE_BACKOFF_MS=15000    # Base backoff (doubles per retry, capped at 30 min)

# ---------------------------------------------------------------------------
# Mobile OTP (SMS) — src/sms/sms.service.ts. Used for registration mobile
# verification, mobile-number-change verification, and as the login second
# factor once a customer's mobile number is verified. OTP generation and
# verification ALWAYS happen entirely on this server (see otp.utils.ts) — no
# third party is ever involved in checking whether a code is correct, and a
# failed/unconfigured send is NEVER reported to the customer as "sent" (see
# otp.utils.assertDelivered). This block only configures how the SMS text
# itself gets delivered.
#
# ⚠ India (TRAI) DLT requirement — applies no matter which provider you pick:
# sending transactional/OTP SMS to an Indian mobile number legally requires
# (1) a DLT-registered Sender ID and (2) a DLT-registered, pre-approved
# message template, both obtained from a telecom operator's DLT platform (or
# bundled by your aggregator, e.g. MSG91/Kaleyra/Gupshup make this easy).
# Without both, operators will silently drop the SMS — this is an operational
# registration step you must complete yourself; no code change can bypass it.
#
# SMS_PROVIDER = "self_hosted" (default) | "twilio" | "msg91" | "generic_http"
#
# self_hosted: posts { "to", "message" } as JSON to a gateway YOU run and
# control — e.g. a GSM-modem box on your own network running Gammu/SMSTools3,
# a self-hosted "SMS Gateway" app on an Android phone with a SIM card, or any
# small script you write — instead of a commercial SMS API. Still subject to
# the DLT rule above once the SIM is sending to Indian numbers.
# ---------------------------------------------------------------------------
SMS_PROVIDER=self_hosted
SELF_HOSTED_SMS_URL=           # e.g. http://192.168.1.50:8080/send-sms (your own gateway)
SELF_HOSTED_SMS_API_KEY=       # optional bearer token, only if your gateway requires one

# msg91 — DLT-compliant Indian transactional SMS aggregator, sent via MSG91's
# Flow API (https://control.msg91.com/api/v5/flow). All three are required:
# MSG91_AUTH_KEY=                   # from your MSG91 dashboard
# MSG91_SENDER_ID=                  # your DLT-approved 6-char sender ID, e.g. PRMLKZ
# MSG91_DLT_TEMPLATE_ID=            # the DLT-approved template ID for your OTP message
# MSG91_OTP_VARIABLE_NAME=OTP       # the variable name your template uses for the code (default "OTP")

# generic_http — a configurable field-mapped adapter for any OTHER Indian or
# international transactional SMS provider (Kaleyra, Gupshup, Fast2SMS,
# TextLocal, AWS SNS, etc.) that doesn't match the shapes above:
# GENERIC_SMS_URL=                  # the provider's send-SMS endpoint
# GENERIC_SMS_METHOD=POST           # GET or POST (default POST)
# GENERIC_SMS_CONTENT_TYPE=json     # "json" or "form" (POST only; default json)
# GENERIC_SMS_TO_FIELD=to           # field name the provider expects for the destination number
# GENERIC_SMS_MESSAGE_FIELD=message # field name the provider expects for the message text
# GENERIC_SMS_SENDER_FIELD=         # optional field name for a sender ID, e.g. "sender"
# GENERIC_SMS_SENDER_ID=            # your DLT-approved sender ID value, if the provider needs one
# GENERIC_SMS_AUTH_HEADER_NAME=     # e.g. "Authorization" or "authkey" — sent as an HTTP header
# GENERIC_SMS_AUTH_HEADER_VALUE=    # the header's value (e.g. "Bearer xxx", or just the raw key)
# GENERIC_SMS_AUTH_PARAM_NAME=      # instead of/in addition to a header, some providers expect
                                     # the key as a query/body param under this name
# GENERIC_SMS_ERROR_INDICATOR=      # optional: a substring that, if present in the response body,
                                     # is treated as a failure even when the HTTP status is 2xx
                                     # (several Indian providers return 200 with an error payload)

# Twilio (opt-in alternative — only used when SMS_PROVIDER=twilio). Never put
# real values here in .env.example — this file is a committed template; real
# secrets belong only in your local/server .env (gitignored, never committed).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Exactly one of the following two is required (not both):
# TWILIO_FROM_NUMBER=          # A Twilio phone number in E.164 format, e.g. +15551234567
# TWILIO_MESSAGING_SERVICE_SID=
