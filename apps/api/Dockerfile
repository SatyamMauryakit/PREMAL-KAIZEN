# syntax=docker/dockerfile:1
#
# Multi-stage production build for @premal/api (NestJS 10 + Prisma 5).
#
# Build:
#   docker build -f apps/api/Dockerfile -t premal-api:local .
#   (build context MUST be the monorepo root, not apps/api - this is a pnpm workspace
#   and the lockfile/other apps' package.json files are needed to resolve correctly)
#
# Run (local/test only - see README in the phase report for real env var requirements):
#   docker run --rm -p 3002:3002 --env-file apps/api/.env premal-api:local

ARG NODE_VERSION=24.21.0

# ---- base: pin Node + pnpm exactly as the project does (.nvmrc / packageManager) ----
FROM node:${NODE_VERSION}-slim AS base
# node:*-slim has no openssl, so Prisma's engine-selection can't detect the libssl
# version and silently guesses (confirmed via build log warning) - installing it
# properly avoids relying on that guess.
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@12.4.2 --activate
WORKDIR /app

# ---- deps: install the whole workspace with a frozen lockfile ----
# Installing from inside this Linux stage (not copying a host node_modules) is what
# makes native modules (bcrypt, sharp - the latter a transitive dep of Next.js in the
# other two apps) resolve/compile correctly for this image's actual platform.
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/api/package.json ./apps/api/package.json
COPY apps/storefront/package.json ./apps/storefront/package.json
COPY apps/api/prisma ./apps/api/prisma
RUN pnpm install --frozen-lockfile

# ---- build: compile the API (Prisma Client was already generated by deps' postinstall) ----
FROM deps AS build
COPY . .
RUN pnpm --filter @premal/api run build

# ---- runtime: minimal image, non-root, production only ----
FROM node:${NODE_VERSION}-slim AS runtime
# The Prisma query engine binary itself links against libssl at runtime, not just
# during `prisma generate` - needed here too, not only in the build stage.
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# Fixed numeric UID/GID (not --system's dynamically-assigned one) - this is what makes
# the EC2 host's persistent-data directory ownership in deploy.sh deterministic instead
# of guessed. 10001 is chosen specifically to sit outside node:*-slim's system UID
# range (0-999), so it can never collide with a dynamically-assigned system account.
RUN groupadd --gid 10001 appuser && useradd --uid 10001 --gid 10001 --no-create-home appuser
WORKDIR /app
ENV NODE_ENV=production

# Full node_modules (not a --prod prune) is copied deliberately: a pnpm --prod-only
# install in this stage would re-run @premal/api's own postinstall (`prisma generate`),
# which needs the `prisma` CLI - a devDependency that a --prod install excludes outright,
# breaking the build. Copying forward what the build stage already generated avoids
# that failure mode entirely, at the cost of a larger image than a fully pruned one.
# --chown on the COPY itself (not a separate `RUN chown -R` afterward) - a recursive
# chown pass over the whole node_modules tree took ~6 minutes and destabilized the
# local Docker daemon during testing; setting ownership during the copy is one pass,
# not two, over every file.
COPY --from=build --chown=appuser:appuser /app/node_modules ./node_modules
COPY --from=build --chown=appuser:appuser /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build --chown=appuser:appuser /app/apps/api/dist ./apps/api/dist
COPY --from=build --chown=appuser:appuser /app/apps/api/prisma ./apps/api/prisma
COPY --from=build --chown=appuser:appuser /app/apps/api/package.json ./apps/api/package.json

# Product-image uploads directory - empty on purpose (see phase report: local-disk
# storage does not persist across container restarts/replicas without a mounted
# volume; this is created so the app has somewhere to write if STORAGE_DRIVER=local
# is used, not as a statement that it's production-ready as-is).
RUN mkdir -p /app/apps/api/uploads && chown appuser:appuser /app/apps/api/uploads

USER appuser
WORKDIR /app/apps/api
EXPOSE 3002

# Liveness: hits the real /api/health route (no DB dependency - see
# src/health/health.controller.ts), not a guessed/invented endpoint.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get({host:'127.0.0.1',port:process.env.API_PORT||3002,path:'/api/health'},(r)=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "dist/main"]
