# syntax=docker/dockerfile:1
#
# Multi-stage production build for @premal/api (NestJS 10 + Prisma 5).
#
# Build (SQLite - local dev/testing default):
#   docker build -f apps/api/Dockerfile -t premal-api:local .
#   (build context MUST be the monorepo root, not apps/api - this is a pnpm workspace
#   and the lockfile/other apps' package.json files are needed to resolve correctly)
#
# Build (PostgreSQL - matches production/K8s, see deploy/k8s/ and
# apps/api/prisma-postgres/schema.prisma):
#   docker build -f apps/api/Dockerfile --build-arg DATABASE_PROVIDER=postgresql \
#     -t premal-api:postgres-local .
#
# Run (local/test only - see README in the phase report for real env var requirements):
#   docker run --rm -p 3002:3002 --env-file apps/api/.env premal-api:local

ARG NODE_VERSION=24.21.0
# "sqlite" (default, matches local dev) or "postgresql" (production/K8s - see
# deploy/k8s/, which expects an image built with DATABASE_PROVIDER=postgresql).
ARG DATABASE_PROVIDER=sqlite

# ---- base: pin Node + pnpm exactly as the project does (.nvmrc / packageManager) ----
FROM node:${NODE_VERSION}-slim AS base
# node:*-slim has no openssl, so Prisma's engine-selection can't detect the libssl
# version and silently guesses (confirmed via build log warning) - installing it
# properly avoids relying on that guess.
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@12.4.2 --activate
WORKDIR /app

# ---- deps: install the whole workspace with a frozen lockfile ----
# Installing from inside this Linux stage (not copying a host node_modules) is what
# makes native modules (bcrypt, sharp - the latter a transitive dep of Next.js in the
# other two apps) resolve/compile correctly for this image's actual platform.
FROM base AS deps
ARG DATABASE_PROVIDER
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/api/package.json ./apps/api/package.json
COPY apps/storefront/package.json ./apps/storefront/package.json
COPY apps/api/prisma ./apps/api/prisma
COPY apps/api/prisma-postgres ./apps/api/prisma-postgres
RUN pnpm install --frozen-lockfile
# @premal/api's postinstall just ran `prisma generate` against apps/api/prisma/schema.prisma
# (the SQLite one) unconditionally - that's correct for a sqlite-provider image, but
# wrong for a postgres one: the running app always imports the SHARED client at
# node_modules/@prisma/client (see that schema file's own header comment), and
# apps/api/prisma-postgres/schema.prisma deliberately generates to an ISOLATED
# ./generated-client output (so a local ad-hoc Postgres test never clobbers the dev
# SQLite client - see that file's header comment) - which means a plain
# `prisma generate --schema=apps/api/prisma-postgres/schema.prisma` here would NOT
# overwrite the shared client the app actually runs against. For a postgres build,
# regenerate from a one-off copy of that schema with the `output` override stripped,
# so it lands at the same shared location the SQLite generate just used - the app
# code itself never needs to know or care which provider it was built against.
# Invoke the pinned local prisma CLI directly (apps/api/node_modules/.bin/prisma,
# matching deploy/k8s/04-migration-job.yaml's own convention) - `npx prisma` here
# resolved to a completely different, unpinned major version (8.x, fetched fresh
# from the registry) instead of the installed 5.22.0, because pnpm's workspace
# install doesn't hoist `prisma`'s bin to the root node_modules/.bin in this
# project's configuration. A version-mismatched CLI against a 5.22.0 @prisma/client
# is exactly the kind of silent inconsistency this build-arg branch must not risk.
RUN if [ "$DATABASE_PROVIDER" = "postgresql" ]; then \
      sed '/output.*generated-client/d' apps/api/prisma-postgres/schema.prisma > apps/api/schema.postgresql.prisma && \
      apps/api/node_modules/.bin/prisma generate --schema=apps/api/schema.postgresql.prisma && \
      rm apps/api/schema.postgresql.prisma; \
    fi

# ---- build: compile the API (Prisma Client was already generated by deps' postinstall) ----
FROM deps AS build
COPY . .
RUN pnpm --filter @premal/api run build
# `pnpm run build` triggers the package's `prebuild` (`prisma generate` against the SQLite
# schema), which overwrites the Postgres client generated in the deps stage. Regenerate it
# here, after the build, so the runtime image really talks to Postgres.
ARG DATABASE_PROVIDER
RUN if [ "$DATABASE_PROVIDER" = "postgresql" ]; then \
      sed '/output.*generated-client/d' apps/api/prisma-postgres/schema.prisma > apps/api/schema.postgresql.prisma && \
      apps/api/node_modules/.bin/prisma generate --schema=apps/api/schema.postgresql.prisma && \
      rm apps/api/schema.postgresql.prisma; \
    fi

# ---- runtime: minimal image, non-root, production only ----
FROM node:${NODE_VERSION}-slim AS runtime
# The Prisma query engine binary itself links against libssl at runtime, not just
# during `prisma generate` - needed here too, not only in the build stage. tini is a
# minimal init process (PID 1) that correctly forwards SIGTERM to `node dist/main`
# and reaps zombie processes - without it, Node itself is PID 1, which works for
# signal delivery but leaves no zombie-reaping and no safety net if Node ever forks
# a child (Prisma's query engine is a separate OS process, not a Node child, but
# this is still the documented, standard fix for "graceful shutdown" in containers).
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*
# Fixed numeric UID/GID (not --system's dynamically-assigned one) - this is what makes
# the EC2 host's persistent-data directory ownership in deploy.sh deterministic instead
# of guessed. 10001 is chosen specifically to sit outside node:*-slim's system UID
# range (0-999), so it can never collide with a dynamically-assigned system account.
RUN groupadd --gid 10001 appuser && useradd --uid 10001 --gid 10001 --no-create-home appuser
WORKDIR /app
ENV NODE_ENV=production

# Full node_modules (not a --prod prune) is copied deliberately: a pnpm --prod-only
# install in this stage would re-run @premal/api's own postinstall (`prisma generate`),
# which needs the `prisma` CLI - a devDependency that a --prod install excludes outright,
# breaking the build. Copying forward what the build stage already generated avoids
# that failure mode entirely, at the cost of a larger image than a fully pruned one.
# --chown on the COPY itself (not a separate `RUN chown -R` afterward) - a recursive
# chown pass over the whole node_modules tree took ~6 minutes and destabilized the
# local Docker daemon during testing; setting ownership during the copy is one pass,
# not two, over every file.
COPY --from=build --chown=appuser:appuser /app/node_modules ./node_modules
COPY --from=build --chown=appuser:appuser /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build --chown=appuser:appuser /app/apps/api/dist ./apps/api/dist
COPY --from=build --chown=appuser:appuser /app/apps/api/prisma ./apps/api/prisma
# Always included regardless of DATABASE_PROVIDER (cheap - it's just schema/migration
# SQL, no generated client) so a postgres-flavored image always has
# `apps/api/prisma-postgres/migrations/` available for the K8s migration Job
# (deploy/k8s/04-migration-job.yaml) to run `prisma migrate deploy` against.
COPY --from=build --chown=appuser:appuser /app/apps/api/prisma-postgres ./apps/api/prisma-postgres
COPY --from=build --chown=appuser:appuser /app/apps/api/package.json ./apps/api/package.json

# Product-image uploads directory - empty on purpose (see phase report: local-disk
# storage does not persist across container restarts/replicas without a mounted
# volume; this is created so the app has somewhere to write if STORAGE_DRIVER=local
# is used, not as a statement that it's production-ready as-is).
RUN mkdir -p /app/apps/api/uploads && chown appuser:appuser /app/apps/api/uploads

USER appuser
WORKDIR /app/apps/api
EXPOSE 3002

# Liveness: hits the real /api/health route (no DB dependency - see
# src/health/health.controller.ts), not a guessed/invented endpoint.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get({host:'127.0.0.1',port:process.env.API_PORT||3002,path:'/api/health'},(r)=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/main"]
